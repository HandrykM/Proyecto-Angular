# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=proyecto_agua
DB_SSL=false

# ============================================
# CONFIGURACIÓN DE JWT
# ============================================
JWT_SECRET=tu_clave_secreta_super_segura_aqui_cambiala_en_produccion
JWT_EXPIRES_IN=24h

# ============================================
# CONFIGURACIÓN DE EMAIL (para reset password)
# ============================================
EMAIL_SERVICE=gmail
EMAIL_USER=hydrosave05@gmail.com
EMAIL_PASSWORD=gurh bkxz lnzp puhx
EMAIL_FROM="HydroSave <hydrosave05@gmail.com>"

# Alternativa con SMTP personalizado
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_USER=hydrosave05@gmail.com
SMTP_AUTH_PASS=Hydr@Save*_05

# ============================================
# CONFIGURACIÓN DE CORS
# ============================================
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,https://tu-dominio.com

# ============================================
# CONFIGURACIÓN DE ARCHIVOS
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,gif

# ============================================
# CONFIGURACIÓN DE LOGS
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ============================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=50

# Configuración de sesiones (si se usa)
SESSION_SECRET=otra_clave_secreta_para_sesiones
SESSION_TIMEOUT=1800000

# ============================================
# CONFIGURACIÓN DE REDIS (opcional)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# CONFIGURACIÓN DE NOTIFICACIONES PUSH (futuro)
# ============================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hydrosave.com

# ============================================
# CONFIGURACIÓN DE ANALYTICS (opcional)
# ============================================
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=

# ============================================
# CONFIGURACIÓN DE ALMACENAMIENTO EN LA NUBE (opcional)
# ============================================
# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=hydrosave-files

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_KEY_FILE=./config/gcloud-key.json
GOOGLE_CLOUD_BUCKET=hydrosave-storage

# ============================================
# CONFIGURACIÓN DE MONITOREO
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# New Relic (opcional)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=HydroSave API

# ============================================
# CONFIGURACIÓN DE BACKUP
# ============================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups

# ============================================
# CONFIGURACIÓN DE TESTING
# ============================================
TEST_DB_NAME=proyecto_agua_test
TEST_JWT_SECRET=test_secret_key
TEST_TIMEOUT=30000

# ============================================
# CONFIGURACIÓN DE DESARROLLO
# ============================================
# Activar logs detallados en desarrollo
DEBUG=app:*
VERBOSE_LOGGING=true

# Hot reload y watch files
WATCH_FILES=true
NODEMON_IGNORE=node_modules,dist,logs

# ============================================
# CONFIGURACIÓN DE PRODUCCIÓN
# ============================================
# Compresión de respuestas
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6

# Headers de seguridad
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000

# Cache de respuestas
CACHE_ENABLED=true
CACHE_MAX_AGE=300

# ============================================
# CONFIGURACIÓN DE API EXTERNA (futuro)
# ============================================
# API del clima para datos de agua
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# API de mapas
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ============================================
# CONFIGURACIÓN DE CRON JOBS
# ============================================
CRON_ENABLED=true

# Limpiar logs antiguos (diario a las 3 AM)
CLEANUP_LOGS_SCHEDULE=0 3 * * *

# Backup de base de datos (diario a las 2 AM)
DB_BACKUP_SCHEDULE=0 2 * * *

# Enviar recordatorios de estudio (lunes a viernes a las 9 AM)
STUDY_REMINDER_SCHEDULE=0 9 * * 1-5

# ============================================
# CONFIGURACIÓN DE WEBHOOKS (opcional)
# ============================================
WEBHOOK_SECRET=webhook_secret_key
PAYMENT_WEBHOOK_URL=/api/webhooks/payment
NOTIFICATION_WEBHOOK_URL=/api/webhooks/notification


# ============================================
# CONFIGURACIÓN DEL CLIENTE (FRONTEND ANGULAR)
# ============================================
CLIENT_URL=http://localhost:4200
# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. Renombra este archivo a .env
# 2. Cambia todas las claves secretas por valores únicos y seguros
# 3. No subas el archivo .env real a control de versiones
# 4. En producción, usa variables de entorno del servidor/contenedor
# 5. Considera usar servicios como AWS Secrets Manager o Azure Key Vault

